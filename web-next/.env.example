# Copie para .env.local:  cp .env.example .env.local
# Nunca commite .env.local (já está no .gitignore).

# Browser: same-origin via rewrite Next → nó.
NEXT_PUBLIC_API_BASE=/api

# SSR + rewrite /api/* → nó local.
EAV7_API_ORIGIN=http://127.0.0.1:6070

# Mock só com opt-in explícito (nunca em production).
# NEXT_PUBLIC_USE_MOCK=true

# NEXT_PUBLIC_NETWORK=mainnet
